# ─────────────────────────────────────────────────────────────
# CyberGrid: Breach & Sync — variables de entorno
# Copia este archivo como .env y ajusta los valores.
# NUNCA subas el archivo .env al repositorio.
# ─────────────────────────────────────────────────────────────

# Entorno: development | test | production
NODE_ENV=development

# Puerto y dirección de escucha del servidor HTTP + WebSocket
PORT=3000
HOST=0.0.0.0

# Cadena de conexión de PostgreSQL (obligatoria)
DATABASE_URL=postgres://cybergrid:cybergrid@localhost:5432/cybergrid
# true si el proveedor exige SSL desde fuera de su red (p. ej. URL externa de Render)
DATABASE_SSL=false
DATABASE_POOL_MAX=10

# Base de datos aislada para Vitest (integración) y Playwright (E2E)
TEST_DATABASE_URL=postgres://cybergrid:cybergrid@localhost:5432/cybergrid_test

# Duración de la sesión (horas). La cookie es HttpOnly, SameSite=Lax y Secure en producción.
SESSION_TTL_HOURS=168

# Orígenes permitidos (CORS) separados por comas.
# Déjalo vacío si el servidor sirve también el cliente (despliegue recomendado, mismo origen).
CORS_ORIGINS=

# Saltos de proxy de confianza (Render/Railway usan 1). Por defecto: 1 en producción, 0 en otros entornos.
# TRUST_PROXY=1

# Endpoints de evaluación /api/test/*
# Fuera de producción están activos por defecto. En producción hay que activarlos
# explícitamente y TEST_API_KEY es obligatoria (mínimo 16 caracteres).
# ENABLE_TEST_ENDPOINTS=true
# TEST_API_KEY=cambia-esta-clave-larga-y-aleatoria

# Ritmo de la partida en segundos (10-1800): tiempo de referencia por cada 15 puntos.
# La duración máxima de cada modo es base × objetivo / 15
# (con 180 s → 30 pts: 6:00 · 40 pts: 8:00 · 50 pts: 10:00).
MATCH_DURATION_S=180

# Imagen de apariencia del personaje (PNG/JPEG)
# Tamaño máximo del archivo en bytes (por defecto 2 MB) y lado máximo de la imagen original en px.
AVATAR_MAX_BYTES=2097152
AVATAR_MAX_DIMENSION=4096

# El servidor sirve el cliente compilado (client/dist)
SERVE_CLIENT=true

# Nivel de registro: debug | info | warn | error | silent
LOG_LEVEL=info

# Solo si el cliente se aloja en OTRO dominio: URL pública del backend,
# usada al compilar el cliente (npm run build:client).
# PUBLIC_SERVER_URL=https://cybergrid-api.onrender.com
